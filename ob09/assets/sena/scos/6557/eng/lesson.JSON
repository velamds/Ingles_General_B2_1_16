rs.", "type": "text"}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"content": "engenn9le16ob09re5aud01", "type": "audio"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "and she could have answered that. ", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "engenn9le16ob09re5aud02", "type": "audio"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 1, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "been much more formal.", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "engenn9le16ob09re5aud03", "type": "audio"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 2, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "have talked so much.", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "engenn9le16ob09re5aud04", "type": "audio"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 3, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "with, \u201cFine thank you.\u201d", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "engenn9le16ob09re5aud05", "type": "audio"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 4, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "how he was.", "type": "text"}], "selected": 0}]}], "type": "MT1", "id": 4, "stimuli_ids": []}, {"template_override": 1, "_data