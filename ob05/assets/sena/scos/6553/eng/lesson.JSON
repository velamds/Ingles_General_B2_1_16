ta": [{"type": "question", "contents": [{"content": "engenn9le16ob05re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 0, "selected": 0}], "id": 0}]}], "id": 0, "stimuli": [{"_data": [], "type": "welcome", "template_override": 1, "id": 0, "contents": [{}]}, {"title": "", "id": 1, "contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "id": 0, "text": ""}, {"time": "1000", "image": "", "id": 1, "text": "<span class= \"strong\">Boris</span>: Ms. Concerto, have a seat. How are you doing today?<br />\n<span class= \"strong\"> Claire</span>: Well, to tell you the truth, it's been kind of a bad day.<br />\n<span class= \"strong\"> Boris</span>: Oh? I'm sorry to hear that.<br />\n<span class= \"strong\"> Claire</span>: Yes. Well, it's raining. I don't really like rainy days ... <br />\n<span class= \"strong\"> Kristi</span>: Geez, this interview has started off on the wrong foot. The question was only meant as polite conversation. She responded as if she was speaking to a good friend. She shouldn't have said that. It sounds informal. She should have responded more formally. She could have said, \u201cFine thank you. And you?\u201d That's a much more appropriate answer.<br />"}, {"time": "44500", "image": "", "id": 2, "text": "<span class= \"strong\"> Boris</span>: So how about on a good day? What do you like to do in your spare time?<br />\n<span class= \"strong\"> Claire</span>: I like reading and uh ... watching TV.<br />\n<span class= \"strong\"> Boris</span>: What's your favorite TV show?<br />\n<span class= \"strong\"> Claire</span>: Oh I love <span class=\"italic\">The Office</span>! It's so funny! Not the American version though, the British one. British people are so funny, you know?<br />\n<span class= \"strong\"> Boris</span>: Yes ... they can be ...<br />\n<span class= \"strong\"> Kristi</span>: She's very talkative. The interviewer is trying to make small talk and she's just rambling on. She should have responded in a way that reflected positively on her overall character and professionalism.<br />"}, {"time": "84000", "image": "", "id": 3, "text": "<span class= \"strong\"> Boris</span>: Okay, let's get down to business. Can you tell me a bit about your previous experience?<br />\n<span class= \"strong\"> Claire</span>: Hmm ... my uncle managed a print shop, and I helped him out a lot. I would be perfect for this job ... <br /><span class= \"strong\"> Kristi</span>: Oh brother. What a mess. I wouldn't have said that. Guess my chances are much better now!<br />"}], "video_src": "engenn9le16ob05re2vid01"}}], "_data": [], "type": "video", "template_override": 1}]}]}